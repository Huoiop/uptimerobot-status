# =========================================================
# UptimeRobot Status - environment variables
# Copy this file to .env and fill in your own values.
# Never commit a real API key or JWT secret.
# =========================================================

# ---------------------------------------------------------
# UptimeRobot API
# ---------------------------------------------------------
# v3 API base URL. API v2 is not supported.
API_URL="https://api.uptimerobot.com/v3/"
# Read-only API key. Get it from:
# https://dashboard.uptimerobot.com/integrations
API_KEY=""

# ---------------------------------------------------------
# Deployment target
# ---------------------------------------------------------
# cloudflare (default) | auto | eo | esa
# cloudflare: Cloudflare Pages via NuxtHub  -> dist/
# auto:       generic Node.js (Vercel, Docker, ...) -> .output/
# eo:         EdgeOne Makers                 -> .edgeone/
# esa:        Alibaba Cloud ESA              -> .output/server + .output/public
DEPLOYMENT_PLATFORM="cloudflare"

# ---------------------------------------------------------
# Site metadata
# ---------------------------------------------------------
# EdgeOne env values cannot contain spaces; use "+" instead, e.g.
# SITE_TITLE="Huoiop+NET+Status"
SITE_TITLE="UptimeRobot Status"
SITE_DESCRIPTION="A simple status page powered by UptimeRobot API v3"
SITE_KEYWORDS="status,uptime,monitoring"
SITE_LOGO="/favicon.ico"

# ---------------------------------------------------------
# Footer / header links
# Leave a value empty to hide the corresponding button.
# ---------------------------------------------------------
SITE_GITHUB="https://github.com/Huoiop/uptimerobot-status"
SITE_HOME=""
SITE_EMAIL=""

# ICP filing number (China only)
SITE_ICP=""

# ---------------------------------------------------------
# Data
# ---------------------------------------------------------
# Number of days of daily uptime bars. 30-90 recommended.
COUNT_DAYS=90
# Show the monitor "open link" button. true | false
SHOW_LINKS=false

# ---------------------------------------------------------
# Optional password protection (JWT)
# ---------------------------------------------------------
# Set both SITE_PASSWORD and SITE_SECRE_KEY, or leave both empty.
# Generate a random secret, for example:
#   openssl rand -hex 32
SITE_PASSWORD=""
# The name intentionally contains the historical typo "SECRE".
SITE_SECRE_KEY=""

# ---------------------------------------------------------
# Author
# ---------------------------------------------------------
# The copyright author is fixed to Huoiop (https://github.com/Huoiop/).
# SITE_AUTHOR / SITE_AUTHOR_URL are no longer used.
